{
  "name": "@soppy-vue/runtime-dom",
  "version": "0.1.0",
  "description": "Vue-like runtime implementation for browser",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@soppy-vue/shared": "workspace:*",
    "@soppy-vue/runtime-core": "workspace:*"
  },
  "buildOptions": {
    "formats": [
      "esm",
      "cjs"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soppylzz/soppy-vue.git",
    "directory": "packages/runtime-dom"
  },
  "keywords": [
    "soppy-vue",
    "mini-vue"
  ],
  "author": "soppylzz",
  "license": "MIT"
}
