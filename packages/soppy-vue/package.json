{
  "name": "soppy-vue",
  "version": "0.0.0",
  "description": "A Vue like framework for learning and understanding the core principles of Vue.js.",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@soppy-vue/shared": "workspace:*"
  },
  "buildOptions": {
    "name": "readVue",
    "formats": [
      "esm",
      "cjs",
      "iife"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/source-readers/soppy-vue.git",
    "directory": "packages/soppy-vue"
  },
  "keywords": [
    "soppy-vue",
    "mini-vue"
  ],
  "author": "soppylzz",
  "license": "MIT"
}
