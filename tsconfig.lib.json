{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "es2022",
    "outDir": "dist",
    "rootDir": "packages",
    "types": ["node"],
    "lib": ["dom", "esnext"],
    "noEmit": false,
    // unavoidable to use `any` in the impl of soppy-vue
    "noImplicitAny": false,
    "emitDeclarationOnly": true,
    "paths": {
      "@soppy-vue/*": ["./packages/*/src"]
    }
  },
  "include": ["packages/*/src", "global.d.ts"]
}
