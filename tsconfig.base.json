{
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "composite": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "emitDeclarationOnly": true,
    "isolatedDeclarations": false,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": ["node_modules", "dist"]
}
